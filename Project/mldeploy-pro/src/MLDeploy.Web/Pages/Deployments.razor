@page "/deployments"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Deployments - MLDeploy Pro</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Deployments</MudText>

@if (_deployments == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <!-- Deployment Stats -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Running</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Success">
                        @_deployments.Count(d => d.Status == "Running")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Pending</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Warning">
                        @_deployments.Count(d => d.Status == "Pending")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Failed</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Error">
                        @_deployments.Count(d => d.Status == "Failed")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Total</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Primary">
                        @_deployments.Count
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Deployments Table -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">All Deployments</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_deployments" Dense="true" Hover="true" Bordered="true">
                        <HeaderContent>
                            <MudTh>Model</MudTh>
                            <MudTh>Version</MudTh>
                            <MudTh>Environment</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Endpoint</MudTh>
                            <MudTh>Deployed</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Model">@GetModelName(context.ModelId)</MudTd>
                            <MudTd DataLabel="Version">
                                <MudChip Size="Size.Small" Variant="Variant.Outlined">@context.Version</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Environment">
                                <MudChip Size="Size.Small" Color="GetEnvColor(context.Environment)">@context.Environment</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip Size="Size.Small" Color="GetStatusColor(context.Status)">@context.Status</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Endpoint">
                                @if (!string.IsNullOrEmpty(context.EndpointUrl))
                                {
                                    <MudLink Href="@context.EndpointUrl" Target="_blank">@context.EndpointUrl</MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not available</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Deployed">@context.DeployedAt.ToString("MMM dd, HH:mm")</MudTd>
                            <MudTd DataLabel="Actions">
                                @if (context.Status == "Running")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" 
                                        Color="Color.Error" OnClick="() => StopDeployment(context.Id)" />
                                }
                                else if (context.Status == "Pending")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" 
                                        Color="Color.Success" OnClick="() => StartDeployment(context.Id)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private List<Deployment>? _deployments;
    private List<MLModel> _models = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _deployments = await Http.GetFromJsonAsync<List<Deployment>>("api/deployments");
            _models = await Http.GetFromJsonAsync<List<MLModel>>("api/models") ?? new List<MLModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private string GetModelName(Guid modelId)
    {
        var model = _models.FirstOrDefault(m => m.Id == modelId);
        return model?.Name ?? "Unknown";
    }

    private async Task StopDeployment(Guid id)
    {
        // TODO: Call API to stop deployment
        await Task.Delay(100);
    }

    private async Task StartDeployment(Guid id)
    {
        // TODO: Call API to start deployment
        await Task.Delay(100);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Running" => Color.Success,
        "Pending" => Color.Warning,
        "Failed" => Color.Error,
        "Stopped" => Color.Default,
        _ => Color.Default
    };

    private Color GetEnvColor(string env) => env switch
    {
        "Production" => Color.Error,
        "Staging" => Color.Warning,
        "Development" => Color.Info,
        _ => Color.Default
    };

    public class Deployment
    {
        public Guid Id { get; set; }
        public Guid ModelId { get; set; }
        public string Version { get; set; } = "";
        public string Environment { get; set; } = "";
        public string Status { get; set; } = "";
        public string? EndpointUrl { get; set; }
        public DateTime DeployedAt { get; set; }
    }

    public class MLModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}