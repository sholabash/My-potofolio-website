@page "/"
@inject HttpClient Http

<PageTitle>MLDeploy Pro - Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_stats == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <!-- Stats Cards -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Total Models</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Primary">@_stats.TotalModels</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Active Deployments</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Success">@_stats.ActiveDeployments</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">Total Predictions</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Info">@_stats.TotalPredictions</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption">System Status</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Success">Healthy</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Recent Models Table -->
        <MudItem xs="12" md="8">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Recent Models</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_models" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Framework</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Framework">
                                <MudChip Size="Size.Small" Color="Color.Info">@context.Framework</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip Size="Size.Small" Color="Color.Success">@context.Status</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Quick Actions -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Quick Actions</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                        Href="models" FullWidth="true" Class="mb-2">
                        Register New Model
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" 
                        Href="deployments" FullWidth="true">
                        Deploy Model
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardStats? _stats;
    private List<MLModel> _models = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Http.GetFromJsonAsync<DashboardStats>("api/dashboard/stats");
            _models = await Http.GetFromJsonAsync<List<MLModel>>("api/models") ?? new List<MLModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
    }

    public class DashboardStats
    {
        public int TotalModels { get; set; }
        public int ActiveDeployments { get; set; }
        public int TotalPredictions { get; set; }
    }

    public class MLModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Framework { get; set; } = "";
        public string Status { get; set; } = "";
    }
}